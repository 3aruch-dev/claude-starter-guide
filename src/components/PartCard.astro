---
// A clickable card for one Part of the guide, used on the home page.
import { Icon } from '@astrojs/starlight/components';
import type { ComponentProps } from 'astro/types';

interface Props {
	part: string;
	title: string;
	href: string;
	icon: ComponentProps<typeof Icon>['name'];
}

const { part, title, href, icon } = Astro.props;
---

<a class="part-card not-content" href={href}>
	<span class="top">
		<span class="icon"><Icon name={icon} size="1.35rem" /></span>
		<span class="part">{part}</span>
	</span>
	<span class="title">{title}</span>
	<span class="body"><slot /></span>
	<span class="go">Read {part} <Icon name="right-arrow" size="1rem" /></span>
</a>

<style>
	.part-card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		height: 100%;
		padding: 1.25rem 1.25rem 1.1rem;
		border: 1px solid var(--guide-card-border);
		border-radius: 0.9rem;
		background: var(--guide-card-bg);
		color: var(--sl-color-gray-2);
		text-decoration: none;
		box-shadow: var(--sl-shadow-sm);
		transition:
			transform 0.18s ease,
			border-color 0.18s ease,
			box-shadow 0.18s ease;
	}
	.part-card:hover,
	.part-card:focus-visible {
		transform: translateY(-3px);
		border-color: var(--sl-color-accent);
		box-shadow: 0 12px 28px -12px var(--guide-glow), var(--sl-shadow-md);
	}
	.top {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.icon {
		display: grid;
		place-items: center;
		width: 2.4rem;
		height: 2.4rem;
		border-radius: 0.65rem;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-text-accent);
	}
	.part {
		font-size: var(--sl-text-xs);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}
	.title {
		margin-top: 0.25rem;
		font-size: var(--sl-text-lg);
		font-weight: 650;
		line-height: 1.3;
		color: var(--sl-color-white);
	}
	.body {
		flex: 1;
		font-size: var(--sl-text-sm);
		line-height: 1.55;
	}
	.go {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.35rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-text-accent);
	}
	.part-card:hover .go :global(svg) {
		transform: translateX(3px);
	}
	.go :global(svg) {
		transition: transform 0.18s ease;
	}
	@media (prefers-reduced-motion: reduce) {
		.part-card,
		.go :global(svg) {
			transition: none;
		}
		.part-card:hover {
			transform: none;
		}
	}
</style>
